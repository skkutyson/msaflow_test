+
+# CUDA가 없는 노드(헤드 노드 등)에서는 컴파일하지 않음.
+# 잘못된 SM 버전으로 컴파일된 .so가 생성되는 것을 방지.
+# Import 시점이 아닌 첫 forward() 호출 시점에 lazy하게 로드하여
+# Apptainer 컨테이너 등 import 시점에 CUDA가 초기화되지 않은 환경을 지원.
+_SUPPORTED_SMS = {70, 75, 80, 86, 89, 90, 100, 120}
+fast_layer_norm_cuda_v2 = None
+_kernel_checked = False
+
+
+def _try_load_kernel() -> None:
+    """CUDA 커널을 lazy하게 로드한다. 첫 forward() 호출 시 1회만 실행."""
+    global fast_layer_norm_cuda_v2, _kernel_checked
+    if _kernel_checked:
+        return
+    _kernel_checked = True
+
+    import logging
+    logger = logging.getLogger(__name__)
+
+    if not torch.cuda.is_available():
+        logger.info(
+            "FusedLayerNorm: CUDA not available, using torch.nn.functional.layer_norm fallback"
+        )
+        return
+
+    cap = torch.cuda.get_device_capability()
+    current_sm = cap[0] * 10 + cap[1]
+
+    if current_sm not in _SUPPORTED_SMS:
+        logger.info(
+            "FusedLayerNorm: sm_%d not in supported set, using torch.nn.functional.layer_norm fallback",
+            current_sm,
+        )
+        return
+
+    build_directory = current_dir if os.access(current_dir, os.W_OK | os.X_OK) else None
+    sys.path.append(current_dir)
+
+    if build_directory is None:
+        from torch.utils.cpp_extension import _get_build_directory
+
+        cache_dir = _get_build_directory("fast_layer_norm_cuda_v2", False)
+        sys.path.append(cache_dir)
+
+    try:
+        fast_layer_norm_cuda_v2 = importlib.import_module("fast_layer_norm_cuda_v2")
+    except ImportError:
+        try:
+            from protenix.model.layer_norm.torch_ext_compile import compile
+
+            fast_layer_norm_cuda_v2 = compile(
+                name="fast_layer_norm_cuda_v2",
+                sources=[
+                    os.path.join(f"{current_dir}/kernel", file)
+                    for file in ["layer_norm_cuda.cpp", "layer_norm_cuda_kernel.cu"]
+                ],
+                extra_include_paths=[f"{current_dir}/kernel"],
+                build_directory=build_directory,
+            )
+        except Exception as e:
+            logger.warning(
+                "FusedLayerNorm: JIT compile failed (%s), using torch.nn.functional.layer_norm fallback",
+                e,
+            )
 
 
 class FusedLayerNormAffineFunction(torch.autograd.Function):
